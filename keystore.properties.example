# Example keystore configuration for signing release builds.
# Copy this file to 'keystore.properties' and fill in your actual credentials.
# NEVER commit keystore.properties or *.jks / *.keystore files to version control!
#
# To generate a new upload keystore with keytool:
# keytool -genkeypair -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
storeFile=upload-keystore.jks
storePassword=your_keystore_password
keyAlias=upload
keyPassword=your_key_password
